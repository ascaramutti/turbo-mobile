<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/turbo_primary_container" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/turbo_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/turbo_stroke" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
