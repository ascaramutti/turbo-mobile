<?xml version="1.0" encoding="utf-8"?>
<!-- W-15 Vehicle form (Add and Edit): top bar + scrolling form + "Save" button fixed at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/turbo_background"
    android:orientation="vertical"
    tools:context=".ui.owner.VehicleFormActivity">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:id="@+id/form_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/form_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_bold"
                android:text="@string/add_vehicle"
                android:textColor="@color/turbo_text_primary"
                android:textSize="28sp" />

            <!-- Photos: [photo] [photo] ... [+ Add photo] [Minimum 1]. Scrolls sideways when there are many. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Filled in code with item_photo_tile.xml, one per photo. -->
                    <LinearLayout
                        android:id="@+id/photo_list"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/add_photo"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/bg_input"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/turbo_primary"
                        android:drawableTop="@drawable/ic_camera"
                        android:fontFamily="@font/manrope_regular"
                        android:gravity="center"
                        android:paddingVertical="20dp"
                        android:text="@string/add_photo"
                        android:textColor="@color/turbo_text_secondary"
                        android:textSize="12sp" />

                    <!-- Only visible while there are no photos. -->
                    <TextView
                        android:id="@+id/photo_minimum"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input"
                        android:backgroundTint="@color/turbo_primary_container"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/turbo_primary"
                        android:drawableTop="@drawable/ic_image"
                        android:fontFamily="@font/manrope_regular"
                        android:gravity="center"
                        android:paddingVertical="20dp"
                        android:text="@string/photo_minimum"
                        android:textColor="@color/turbo_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Add: shown when "Save vehicle" finds something missing. -->
            <TextView
                android:id="@+id/error_banner"
                style="@style/TurboBanner"
                android:backgroundTint="@color/turbo_error_bg"
                android:drawableStart="@drawable/ic_circle_alert"
                android:drawableTint="@color/turbo_error"
                android:text="@string/form_error"
                android:textColor="@color/turbo_error" />

            <!-- Edit: always shown. -->
            <TextView
                android:id="@+id/warning_banner"
                style="@style/TurboBanner"
                android:backgroundTint="@color/turbo_warning_bg"
                android:drawableStart="@drawable/ic_clock"
                android:drawableTint="@color/turbo_warning"
                android:text="@string/form_edit_warning"
                android:textColor="@color/turbo_warning" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/label_make" />

            <EditText
                android:id="@+id/input_make"
                style="@style/TurboInput"
                android:hint="@string/required"
                android:inputType="textCapWords" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/label_model" />

            <EditText
                android:id="@+id/input_model"
                style="@style/TurboInput"
                android:hint="@string/required"
                android:inputType="textCapWords" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/label_year" />

            <EditText
                android:id="@+id/input_year"
                style="@style/TurboInput"
                android:hint="@string/required"
                android:inputType="number"
                android:maxLength="4" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/label_plate" />

            <EditText
                android:id="@+id/input_plate"
                style="@style/TurboInput"
                android:hint="@string/required"
                android:inputType="textCapCharacters" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/label_vin" />

            <EditText
                android:id="@+id/input_vin"
                style="@style/TurboInput"
                android:hint="@string/required"
                android:inputType="textCapCharacters"
                android:maxLength="17" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/label_category" />

            <Spinner
                android:id="@+id/spinner_category"
                style="@style/TurboInput" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/label_fuel_type" />

            <Spinner
                android:id="@+id/spinner_fuel_type"
                style="@style/TurboInput" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/label_service" />

            <Spinner
                android:id="@+id/spinner_service"
                style="@style/TurboInput" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/label_hourly_rate" />

            <EditText
                android:id="@+id/input_rate"
                style="@style/TurboInput"
                android:hint="@string/required"
                android:inputType="numberDecimal"
                android:maxLength="6" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/label_zone" />

            <Spinner
                android:id="@+id/spinner_zone"
                style="@style/TurboInput" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/label_location" />

            <!-- Opens W-17 Vehicle location; shows the address it sends back. -->
            <TextView
                android:id="@+id/pick_location"
                style="@style/TurboInput"
                android:ellipsize="end"
                android:hint="@string/required"
                android:maxLines="1" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/label_description" />

            <EditText
                android:id="@+id/input_description"
                style="@style/TurboInput"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="@string/optional"
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="96dp"
                android:paddingVertical="16dp"
                android:textColorHint="@color/turbo_text_secondary" />

            <!-- Add only: the two documents the admin reviews (in Edit they live in W-16 Vehicle documents). -->
            <LinearLayout
                android:id="@+id/documents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TurboLabel"
                    android:text="@string/label_insurance" />

                <TextView
                    android:id="@+id/pick_insurance"
                    style="@style/TurboInput"
                    android:hint="@string/choose_photo" />

                <TextView
                    style="@style/TurboLabel"
                    android:text="@string/label_registration" />

                <TextView
                    android:id="@+id/pick_registration"
                    style="@style/TurboInput"
                    android:hint="@string/choose_photo" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/turbo_stroke" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/save"
        style="@style/TurboPrimaryButton"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="12dp"
        android:text="@string/save_vehicle" />
</LinearLayout>
