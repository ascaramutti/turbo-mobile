<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/turbo_background"
    android:orientation="vertical"
    tools:context=".ui.profile.EditProfileActivity">

    <include
        android:id="@+id/top_bar"
        layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/TurboTitle"
                android:text="@string/edit_profile_title" />

            <TextView
                android:id="@+id/error_banner"
                style="@style/TurboBanner.Error"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <!-- Avatar + Change Photo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_avatar"
                    android:clipToOutline="true">

                    <TextView
                        android:id="@+id/avatar_initials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/manrope_bold"
                        android:gravity="center"
                        android:textColor="@color/turbo_text_primary"
                        android:textSize="32sp" />

                    <ImageView
                        android:id="@+id/avatar_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_change_photo"
                    style="@style/TurboSecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/edit_profile_change_photo" />
            </LinearLayout>

            <!-- Form fields -->
            <TextView
                style="@style/TurboLabel"
                android:text="@string/edit_profile_first_name_label" />

            <EditText
                android:id="@+id/first_name"
                style="@style/TurboInput"
                android:hint="@string/edit_profile_first_name_label"
                android:inputType="textPersonName|textCapWords" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/edit_profile_last_name_label" />

            <EditText
                android:id="@+id/last_name"
                style="@style/TurboInput"
                android:hint="@string/edit_profile_last_name_label"
                android:inputType="textPersonName|textCapWords" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/edit_profile_phone_label" />

            <EditText
                android:id="@+id/phone"
                style="@style/TurboInput"
                android:hint="@string/edit_profile_phone_hint"
                android:inputType="phone" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/turbo_stroke" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save"
        style="@style/TurboPrimaryButton"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="12dp"
        android:text="@string/edit_profile_save" />

</LinearLayout>
