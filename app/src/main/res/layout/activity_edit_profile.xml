<?xml version="1.0" encoding="utf-8"?>
<!-- W-10 Edit profile: change name and phone -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/turbo_background"
    android:orientation="vertical"
    tools:context=".ui.profile.EditProfileActivity">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/TurboTitle"
                android:text="@string/editProfile" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/profile_avatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_avatar"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:textColor="@color/turbo_text_primary"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profile_display_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_bold"
                        android:textColor="@color/turbo_text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/profile_role"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/manrope_semibold"
                        android:textColor="@color/turbo_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/banner_info"
                style="@style/TurboBanner.Info"
                android:layout_marginTop="20dp"
                android:text="@string/profileReadyToSave"
                android:visibility="visible" />

            <TextView
                android:id="@+id/banner_error"
                style="@style/TurboBanner.Error"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                style="@style/TurboLabel"
                android:layout_marginTop="20dp"
                android:text="@string/txtFirstName" />

            <EditText
                android:id="@+id/input_first_name"
                style="@style/TurboInput"
                android:autofillHints="personGivenName"
                android:hint="@string/txtFirstName"
                android:inputType="textPersonName|textCapWords" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/txtLastName" />

            <EditText
                android:id="@+id/input_last_name"
                style="@style/TurboInput"
                android:autofillHints="personFamilyName"
                android:hint="@string/txtLastName"
                android:inputType="textPersonName|textCapWords" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/txtPhone" />

            <EditText
                android:id="@+id/input_phone"
                style="@style/TurboInput"
                android:autofillHints="telephoneNumber"
                android:hint="@string/hintPhone"
                android:inputType="phone" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/TurboPrimaryButton"
                android:layout_marginTop="24dp"
                android:text="@string/btnSaveChanges" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
