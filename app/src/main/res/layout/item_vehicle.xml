<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/TurboCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/vehicle_title"
                style="@style/TurboCardTitle" />

            <TextView
                android:id="@+id/vehicle_type"
                style="@style/TurboCardText" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/vehicle_thumbnail"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_turbo_chip"
            android:backgroundTint="@color/turbo_primary_container">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="center"
                android:src="@drawable/ic_photo_placeholder"
                app:tint="@color/turbo_primary" />

            <ImageView
                android:id="@+id/vehicle_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/vehicle_price"
            style="@style/TurboChip"
            android:backgroundTint="@color/turbo_primary_container"
            android:textColor="@color/turbo_primary" />

        <TextView
            android:id="@+id/vehicle_rating"
            style="@style/TurboChip"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/turbo_primary_container"
            android:textColor="@color/turbo_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/vehicle_zone"
        style="@style/TurboCardText"
        android:layout_marginTop="8dp" />
</LinearLayout>
