<?xml version="1.0" encoding="utf-8"?>
<!-- W-16 Vehicle documents: the vehicle, a status message, one card per document
     and a "Re-upload" button at the bottom when a document was rejected. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/turbo_background"
    android:orientation="vertical"
    tools:context=".ui.owner.VehicleDocumentsActivity">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_bold"
                android:text="@string/vehicle_documents"
                android:textColor="@color/turbo_text_primary"
                android:textSize="28sp" />

            <!-- "Ford Escape 2019 · GH7 89J · Burnaby", received from My vehicles. -->
            <TextView
                android:id="@+id/vehicle_summary"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input"
                android:backgroundTint="@color/turbo_primary_container"
                android:drawablePadding="12dp"
                android:drawableTint="@color/turbo_primary"
                android:drawableTop="@drawable/ic_image"
                android:fontFamily="@font/manrope_regular"
                android:gravity="center"
                android:paddingVertical="28dp"
                android:textColor="@color/turbo_text_secondary"
                android:textSize="14sp" />

            <!-- Only one of the three banners is shown, depending on the documents. -->
            <TextView
                android:id="@+id/banner_rejected"
                style="@style/TurboBanner"
                android:backgroundTint="@color/turbo_error_bg"
                android:drawableStart="@drawable/ic_circle_alert"
                android:drawableTint="@color/turbo_error"
                android:text="@string/documents_rejected_banner"
                android:textColor="@color/turbo_error" />

            <TextView
                android:id="@+id/banner_pending"
                style="@style/TurboBanner"
                android:backgroundTint="@color/turbo_warning_bg"
                android:drawableStart="@drawable/ic_clock"
                android:drawableTint="@color/turbo_warning"
                android:textColor="@color/turbo_warning" />

            <TextView
                android:id="@+id/banner_approved"
                style="@style/TurboBanner"
                android:backgroundTint="@color/turbo_success_bg"
                android:drawableStart="@drawable/ic_circle_check"
                android:drawableTint="@color/turbo_success"
                android:text="@string/documents_approved_banner"
                android:textColor="@color/turbo_success" />

            <!-- Filled in code with item_info_card.xml, one per document. -->
            <LinearLayout
                android:id="@+id/document_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- Only visible when a document was rejected. -->
    <LinearLayout
        android:id="@+id/reupload_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/turbo_stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reupload"
            style="@style/TurboPrimaryButton"
            android:layout_marginHorizontal="24dp"
            android:layout_marginVertical="12dp" />
    </LinearLayout>
</LinearLayout>
