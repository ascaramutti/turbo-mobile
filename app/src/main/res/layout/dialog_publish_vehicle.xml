<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp">

    <LinearLayout
        style="@style/TurboCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            style="@style/TurboCardTitle"
            android:text="@string/publish_vehicle_title"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/vehicle_title"
            style="@style/TurboCardText"
            android:textSize="14sp" />

        <TextView
            style="@style/TurboLabel"
            android:text="@string/publish_vehicle_date" />

        <Spinner
            android:id="@+id/publish_day"
            style="@style/TurboFilterChip"
            android:layout_width="match_parent"
            android:layout_marginEnd="0dp" />

        <TextView
            style="@style/TurboLabel"
            android:text="@string/publish_vehicle_time" />

        <Spinner
            android:id="@+id/publish_time"
            style="@style/TurboFilterChip"
            android:layout_width="match_parent"
            android:layout_marginEnd="0dp" />

        <TextView
            style="@style/TurboCardText"
            android:layout_marginTop="12dp"
            android:text="@string/publish_vehicle_hint" />

        <TextView
            android:id="@+id/error_banner"
            style="@style/TurboBanner.Error"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel"
                style="@style/TurboSecondaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/publish_vehicle_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/publish"
                style="@style/TurboPrimaryButton"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/publish_vehicle_publish" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
