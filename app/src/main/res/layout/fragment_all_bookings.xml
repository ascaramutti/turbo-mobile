<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <TextView
            style="@style/TurboTitle"
            android:text="@string/all_bookings_title" />

        <TextView
            android:id="@+id/error_banner"
            style="@style/TurboBanner.Error" />

        <TextView
            style="@style/TurboLabel"
            android:text="@string/all_bookings_month_label" />

        <Spinner
            android:id="@+id/month_spinner"
            style="@style/TurboInput" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/TurboCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1">

                <TextView
                    style="@style/TurboStatLabel"
                    android:text="@string/all_bookings_platform_fee" />

                <TextView
                    android:id="@+id/stat_platform_fee"
                    style="@style/TurboStatValue" />
            </LinearLayout>

            <LinearLayout
                style="@style/TurboCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    style="@style/TurboStatLabel"
                    android:text="@string/all_bookings_payments" />

                <TextView
                    android:id="@+id/stat_payments"
                    style="@style/TurboStatValue" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/TurboCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                style="@style/TurboStatLabel"
                android:text="@string/all_bookings_completed" />

            <TextView
                android:id="@+id/stat_completed"
                style="@style/TurboStatValue" />
        </LinearLayout>

        <TextView
            style="@style/TurboLabel"
            android:text="@string/all_bookings_status_label" />

        <Spinner
            android:id="@+id/status_spinner"
            style="@style/TurboInput" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_bookings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="32dp"
            android:visibility="gone">

            <TextView
                style="@style/TurboEmptyTitle"
                android:text="@string/all_bookings_empty_title" />

            <TextView
                style="@style/TurboEmptyBody"
                android:text="@string/all_bookings_empty_body" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
