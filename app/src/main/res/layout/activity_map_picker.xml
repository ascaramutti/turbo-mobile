<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/turbo_background"
    android:orientation="vertical" >

    <include
        android:id="@+id/top_bar"
        layout="@layout/view_top_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal" >

        <EditText
            android:id="@+id/search_address"
            style="@style/TurboInput"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="@string/map_picker_search_hint"
            android:inputType="textPostalAddress" />

        <Button
            android:id="@+id/search_button"
            style="@style/TurboPrimaryButton"
            android:layout_width="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/map_picker_search" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="40dp"
            android:text="📍"
            android:textSize="40sp" />
    </FrameLayout>

    <TextView
        style="@style/TurboSubtitle"
        android:layout_marginHorizontal="24dp"
        android:text="@string/map_picker_hint" />

    <Button
        android:id="@+id/confirm_location"
        style="@style/TurboPrimaryButton"
        android:layout_margin="24dp"
        android:text="@string/map_picker_confirm" />

</LinearLayout>