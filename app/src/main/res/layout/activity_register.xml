<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/turbo_background"
    android:orientation="vertical"
    tools:context=".ui.auth.RegisterActivity">

    <include
        android:id="@+id/top_bar"
        layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/TurboTitle"
                android:text="@string/register_title" />

            <TextView
                android:id="@+id/error_banner"
                style="@style/TurboBanner.Error" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tab_driver"
                    style="@style/TurboSegment"
                    android:text="@string/register_role_driver" />

                <TextView
                    android:id="@+id/tab_owner"
                    style="@style/TurboSegment"
                    android:text="@string/register_role_owner" />
            </LinearLayout>

            <TextView
                style="@style/TurboLabel"
                android:text="@string/register_first_name" />

            <EditText
                android:id="@+id/first_name"
                style="@style/TurboInput"
                android:hint="@string/register_first_name"
                android:inputType="textPersonName" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/register_last_name" />

            <EditText
                android:id="@+id/last_name"
                style="@style/TurboInput"
                android:hint="@string/register_last_name"
                android:inputType="textPersonName" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/register_email" />

            <EditText
                android:id="@+id/email"
                style="@style/TurboInput"
                android:hint="@string/register_email"
                android:inputType="textEmailAddress" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/register_phone" />

            <EditText
                android:id="@+id/phone"
                style="@style/TurboInput"
                android:hint="@string/register_phone_hint"
                android:inputType="phone" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/register_dob" />

            <EditText
                android:id="@+id/date_of_birth"
                style="@style/TurboInput"
                android:clickable="true"
                android:focusable="false"
                android:hint="@string/register_select_date" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/register_password" />

            <EditText
                android:id="@+id/password"
                style="@style/TurboInput"
                android:hint="@string/register_password"
                android:inputType="textPassword" />

            <TextView
                style="@style/TurboLabel"
                android:text="@string/register_confirm_password" />

            <EditText
                android:id="@+id/confirm_password"
                style="@style/TurboInput"
                android:hint="@string/register_confirm_password"
                android:inputType="textPassword" />

            <LinearLayout
                android:id="@+id/driver_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TurboCardTitle"
                    android:layout_marginTop="16dp"
                    android:text="@string/register_driver_header" />

                <TextView
                    style="@style/TurboLabel"
                    android:text="@string/register_license_number" />

                <EditText
                    android:id="@+id/license_number"
                    style="@style/TurboInput"
                    android:hint="@string/register_license_number"
                    android:inputType="text" />

                <TextView
                    style="@style/TurboLabel"
                    android:text="@string/register_license_class" />

                <Spinner
                    android:id="@+id/license_class"
                    style="@style/TurboInput" />

                <TextView
                    style="@style/TurboLabel"
                    android:text="@string/register_license_expiry" />

                <EditText
                    android:id="@+id/license_expiry"
                    style="@style/TurboInput"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="@string/register_select_date" />

                <TextView
                    style="@style/TurboLabel"
                    android:text="@string/register_study_permit" />

                <EditText
                    android:id="@+id/study_permit_number"
                    style="@style/TurboInput"
                    android:hint="@string/register_study_permit"
                    android:inputType="text" />

                <TextView
                    style="@style/TurboLabel"
                    android:text="@string/register_permit_expiry" />

                <EditText
                    android:id="@+id/study_permit_expiry"
                    style="@style/TurboInput"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="@string/register_select_date" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/terms_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/register_terms"
                android:textColor="@color/turbo_text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_register"
                style="@style/TurboPrimaryButton"
                android:layout_marginTop="16dp"
                android:text="@string/register_button" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
