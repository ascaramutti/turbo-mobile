<?xml version="1.0" encoding="utf-8"?>
<!-- Confirmation dialog from the wireframes (Delete vehicle, Log out, Cancel booking...). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_turbo_dialog"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_bold"
            android:includeFontPadding="false"
            android:textColor="@color/turbo_text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/dialog_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/manrope_regular"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:textColor="@color/turbo_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_cancel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:fontFamily="@font/manrope_semibold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:padding="0dp"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/turbo_primary"
                android:textSize="14sp"
                app:backgroundTint="@color/turbo_surface"
                app:cornerRadius="12dp"
                app:strokeColor="@color/turbo_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_confirm"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/manrope_semibold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:padding="0dp"
                android:textAllCaps="false"
                android:textColor="@color/turbo_on_primary"
                android:textSize="16sp"
                app:backgroundTint="@color/turbo_primary"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
