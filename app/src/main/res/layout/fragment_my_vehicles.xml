<?xml version="1.0" encoding="utf-8"?>
<!-- W-14 My vehicles (list + empty state). Margins measured from the wireframe PDF. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="9dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_bold"
            android:includeFontPadding="false"
            android:text="@string/my_vehicles"
            android:textColor="@color/turbo_text_primary"
            android:textSize="28sp" />

        <LinearLayout
            android:id="@+id/vehicle_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5.5dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="61dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="68dp"
                android:background="@drawable/bg_avatar">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_car_front"
                    app:tint="@color/turbo_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/manrope_bold"
                android:includeFontPadding="false"
                android:text="@string/vehicles_empty_title"
                android:textColor="@color/turbo_text_primary"
                android:textSize="19sp" />

            <TextView
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/manrope_regular"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:text="@string/vehicles_empty_body"
                android:textColor="@color/turbo_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_vehicle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/manrope_semibold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:padding="0dp"
            android:text="@string/add_vehicle"
            android:textAllCaps="false"
            android:textColor="@color/turbo_on_primary"
            android:textSize="16sp"
            app:backgroundTint="@color/turbo_primary"
            app:cornerRadius="12dp" />
    </LinearLayout>
</ScrollView>
