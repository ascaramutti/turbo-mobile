<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp">

    <LinearLayout
        style="@style/TurboCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            style="@style/TurboCardTitle"
            android:text="@string/payment_title"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/amount"
            style="@style/TurboCardText"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/manrope_semibold"
            android:textSize="14sp" />

        <TextView
            style="@style/TurboLabel"
            android:text="@string/payment_card_label" />

        <EditText
            android:id="@+id/card_number"
            style="@style/TurboInput"
            android:digits="0123456789 "
            android:hint="@string/payment_card_hint"
            android:textColorHint="@color/turbo_text_secondary"
            android:inputType="number"
            android:maxLength="19" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TurboLabel"
                    android:text="@string/payment_expiry_label" />

                <EditText
                    android:id="@+id/expiry"
                    style="@style/TurboInput"
                    android:digits="0123456789/"
                    android:hint="@string/payment_expiry_hint"
                    android:textColorHint="@color/turbo_text_secondary"
                    android:inputType="number"
                    android:maxLength="5" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TurboLabel"
                    android:text="@string/payment_cvv_label" />

                <EditText
                    android:id="@+id/cvv"
                    style="@style/TurboInput"
                    android:hint="@string/payment_cvv_hint"
                    android:textColorHint="@color/turbo_text_secondary"
                    android:inputType="numberPassword"
                    android:maxLength="3" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/TurboCardText"
            android:layout_marginTop="12dp"
            android:text="@string/payment_simulated" />

        <TextView
            android:id="@+id/error_banner"
            style="@style/TurboBanner.Error"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel"
                style="@style/TurboSecondaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/payment_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pay"
                style="@style/TurboPrimaryButton"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
