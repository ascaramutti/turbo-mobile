<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/TurboCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/vehicle_thumbnail"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_turbo_chip"
            android:backgroundTint="@color/turbo_primary_container">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="center"
                android:src="@drawable/ic_photo_placeholder"
                app:tint="@color/turbo_primary" />

            <ImageView
                android:id="@+id/vehicle_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/driver_name"
                style="@style/TurboCardTitle" />

            <TextView
                android:id="@+id/vehicle_title"
                style="@style/TurboCardText" />

            <TextView
                android:id="@+id/booking_time"
                style="@style/TurboCardText" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_status"
            style="@style/TurboChip" />

        <TextView
            android:id="@+id/chip_payment"
            style="@style/TurboChip"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reject"
            style="@style/TurboSecondaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/booking_requests_reject" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirm"
            style="@style/TurboPrimaryButton"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/booking_requests_confirm" />
    </LinearLayout>
</LinearLayout>
