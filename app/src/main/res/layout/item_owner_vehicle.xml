<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/TurboCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp">

    <TextView
        android:id="@+id/vehicle_title"
        style="@style/TurboCardTitle" />

    <TextView
        android:id="@+id/vehicle_subtitle"
        style="@style/TurboCardText" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_primary"
            style="@style/TurboChip" />

        <TextView
            android:id="@+id/chip_secondary"
            style="@style/TurboChip"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/action_edit"
            style="@style/TurboCardAction"
            android:text="@string/my_vehicles_edit" />

        <TextView
            style="@style/TurboCardAction"
            android:paddingHorizontal="4dp"
            android:text="@string/my_vehicles_separator" />

        <TextView
            android:id="@+id/action_toggle"
            style="@style/TurboCardAction" />

        <TextView
            android:id="@+id/action_toggle_separator"
            style="@style/TurboCardAction"
            android:paddingHorizontal="4dp"
            android:text="@string/my_vehicles_separator" />

        <TextView
            android:id="@+id/action_documents"
            style="@style/TurboCardAction"
            android:text="@string/my_vehicles_documents" />

        <TextView
            style="@style/TurboCardAction"
            android:paddingHorizontal="4dp"
            android:text="@string/my_vehicles_separator" />

        <TextView
            android:id="@+id/action_delete"
            style="@style/TurboCardAction"
            android:text="@string/my_vehicles_delete" />
    </LinearLayout>
</LinearLayout>
