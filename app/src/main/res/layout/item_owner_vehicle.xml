<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_turbo_card"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/vehicle_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_bold"
        android:includeFontPadding="false"
        android:textColor="@color/turbo_text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/vehicle_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/manrope_regular"
        android:includeFontPadding="false"
        android:textColor="@color/turbo_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_primary"
            style="@style/TurboChip" />

        <TextView
            android:id="@+id/chip_secondary"
            style="@style/TurboChip"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/vehicle_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/manrope_semibold"
        android:includeFontPadding="false"
        android:textColor="@color/turbo_error"
        android:textSize="12sp" />
</LinearLayout>
