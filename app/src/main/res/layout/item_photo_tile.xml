<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="96dp"
    android:layout_height="96dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_input"
    android:backgroundTint="@color/turbo_primary_container">

    <ImageView
        android:id="@+id/photo_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/vehicle_form_photo"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/photo_remove"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/bg_avatar"
        android:backgroundTint="@color/turbo_surface"
        android:contentDescription="@string/vehicle_form_remove_photo"
        android:scaleType="center"
        android:src="@drawable/ic_x"
        app:tint="@color/turbo_error" />
</FrameLayout>
