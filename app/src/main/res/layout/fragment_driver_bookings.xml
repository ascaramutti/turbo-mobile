<?xml version="1.0" encoding="utf-8"?>
<!-- W-08 My bookings: three tabs (Upcoming, In progress, History), the driver's totals and the list. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <TextView
            style="@style/TurboTitle"
            android:text="@string/my_bookings" />

        <!-- The selected tab is marked with setSelected(true), like the bottom bar. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_upcoming"
                style="@style/TurboSegment"
                android:text="@string/tab_upcoming" />

            <TextView
                android:id="@+id/tab_in_progress"
                style="@style/TurboSegment"
                android:text="@string/tab_in_progress" />

            <TextView
                android:id="@+id/tab_history"
                style="@style/TurboSegment"
                android:text="@string/tab_history" />
        </LinearLayout>

        <!-- Totals: hours this week, spent this month, spent in total and completed shifts. Hidden in History. -->
        <LinearLayout
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/TurboCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1">

                    <TextView
                        style="@style/TurboStatLabel"
                        android:text="@string/this_week" />

                    <TextView
                        android:id="@+id/week_hours"
                        style="@style/TurboStatValue" />
                </LinearLayout>

                <LinearLayout
                    style="@style/TurboCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/TurboStatLabel"
                        android:text="@string/this_month" />

                    <TextView
                        android:id="@+id/this_month"
                        style="@style/TurboStatValue" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/TurboCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1">

                    <TextView
                        style="@style/TurboStatLabel"
                        android:text="@string/total_spent" />

                    <TextView
                        android:id="@+id/total_spent"
                        style="@style/TurboStatValue" />
                </LinearLayout>

                <LinearLayout
                    style="@style/TurboCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/TurboStatLabel"
                        android:text="@string/completed_shifts" />

                    <TextView
                        android:id="@+id/completed_shifts"
                        style="@style/TurboStatValue" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_driver_bookings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/bookings_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:fontFamily="@font/manrope_regular"
            android:gravity="center_horizontal"
            android:text="@string/bookings_empty"
            android:textColor="@color/turbo_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
