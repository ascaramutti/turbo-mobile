<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <TextView
            style="@style/TurboTitle"
            android:text="@string/my_bookings_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_upcoming"
                style="@style/TurboSegment"
                android:text="@string/my_bookings_upcoming" />

            <TextView
                android:id="@+id/tab_in_progress"
                style="@style/TurboSegment"
                android:text="@string/my_bookings_in_progress" />

            <TextView
                android:id="@+id/tab_history"
                style="@style/TurboSegment"
                android:text="@string/my_bookings_history" />
        </LinearLayout>

        <TextView
            android:id="@+id/error_banner"
            style="@style/TurboBanner.Error" />

        <TextView
            android:id="@+id/success_banner"
            style="@style/TurboBanner.Success"
            android:text="@string/booking_confirm_sent" />

        <LinearLayout
            android:id="@+id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/TurboCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1">

                    <TextView
                        style="@style/TurboStatLabel"
                        android:text="@string/my_bookings_this_week" />

                    <TextView
                        android:id="@+id/week_hours"
                        style="@style/TurboStatValue" />
                </LinearLayout>

                <LinearLayout
                    style="@style/TurboCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/TurboStatLabel"
                        android:text="@string/my_bookings_this_month" />

                    <TextView
                        android:id="@+id/month_spent"
                        style="@style/TurboStatValue" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/TurboCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1">

                    <TextView
                        style="@style/TurboStatLabel"
                        android:text="@string/my_bookings_total_spent" />

                    <TextView
                        android:id="@+id/total_spent"
                        style="@style/TurboStatValue" />
                </LinearLayout>

                <LinearLayout
                    style="@style/TurboCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/TurboStatLabel"
                        android:text="@string/my_bookings_completed" />

                    <TextView
                        android:id="@+id/completed_shifts"
                        style="@style/TurboStatValue" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_bookings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="64dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="48dp"
                android:background="@drawable/bg_avatar">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar_days"
                    app:tint="@color/turbo_primary" />
            </FrameLayout>

            <TextView
                style="@style/TurboEmptyTitle"
                android:text="@string/my_bookings_empty_title" />

            <TextView
                style="@style/TurboEmptyBody"
                android:text="@string/my_bookings_empty_body" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
