<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".TurboApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TURBO">
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.driver.DriverHomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.owner.OwnerHomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.AdminHomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.DocumentReviewActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.InspectionPhotosActivity"
            android:exported="false" />
        <activity
            android:name=".ui.driver.VehicleDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.driver.BookingDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.driver.TripPhotosActivity"
            android:exported="false" />
        <activity
            android:name=".ui.driver.MyDocumentsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.owner.VehicleFormActivity"
            android:exported="false" />
        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.auth.login"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.owner.MapPickerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".service.ShiftReminderService"
            android:enabled="true"
            android:exported="false"></service>
    </application>

</manifest>